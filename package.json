{
  "name": "storymaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "dev:web": "npm run dev -w @storymaster/web",
    "build": "npm run typecheck && npm run build -w @storymaster/web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint . && node scripts/check-architecture.mjs && node --import tsx scripts/sync-editorial-contracts.mjs --check && node --import tsx scripts/sync-narrative-contracts.mjs --check && node --import tsx scripts/publish-narrative-registry.ts --check && node --import tsx scripts/sync-collaboration-contracts.mjs --check",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "bench:contention": "node --env-file-if-exists=.env --import tsx scripts/measure-contention.ts",
    "bench:scenes": "node --env-file-if-exists=.env --import tsx scripts/measure-scene-contention.ts",
    "bench:narrative": "node --env-file-if-exists=.env --import tsx scripts/measure-narrative.ts",
    "bench:collaboration": "node --env-file-if-exists=.env --import tsx scripts/measure-collaboration.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "globals": "16.5.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.8.2"
  }
}
