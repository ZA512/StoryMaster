              "required": [
                "id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "tempId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              },
              "required": [
                "tempId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "referenceType": {
          "enum": [
            "present",
            "mentioned",
            "point_of_view",
            "setting",
            "depicts_event"
