{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opération narrative proposée — contrat de spécification",
  "description": "Schéma structurel ; autorisation, révisions, unicité des cibles, cycles, types et modules validés par domaine.",
  "allOf": [
    {
      "$ref": "#/$defs/Operation"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 1
    },
    "ObjectRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tempId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "tempId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RichNode": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "doc",
            "paragraph",
            "text",
            "heading",
            "bulletList",
            "orderedList",
            "listItem",
            "blockquote",
            "hardBreak"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 1000000
        },
        "attrs": {
          "type": "object"
        },
        "marks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "bold",
                  "italic",
                  "strike",
                  "link"
                ]
              },
              "attrs": {
                "type": "object"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RichNode"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "RichDocument": {
      "allOf": [
        {
          "$ref": "#/$defs/RichNode"
        },
        {
          "properties": {
            "type": {
              "const": "doc"
            }
          },
          "required": [
            "content"
