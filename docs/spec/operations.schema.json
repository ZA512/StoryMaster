        "conflicts": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "traits": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "healthSummary": {
          "type": "string",
          "maxLength": 4000
        },
        "conditionEventRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
