{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web"
  ]
}
