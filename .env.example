# Démonstration locale uniquement. Aucun de ces identifiants n'est un secret réel.
# Ne jamais utiliser ce fichier pour un déploiement public.
COMPOSE_PROJECT_NAME=storymaster
APP_ENV=local
PUBLIC_ORIGIN=http://localhost:3000
OIDC_ORIGIN=http://localhost:8080
OIDC_ISSUER=http://localhost:8080/realms/storymaster
OIDC_CLIENT_ID=storymaster-web
SESSION_SECRET=local-only-storymaster-session-key-change-before-any-public-use
SESSION_SECONDS=28800
POSTGRES_PASSWORD=local-only-postgres-admin
APP_DB_PASSWORD=local-only-app-db
MIGRATION_DB_PASSWORD=local-only-migration-db
KEYCLOAK_DB_PASSWORD=local-only-keycloak-db
KEYCLOAK_ADMIN_PASSWORD=local-only-keycloak-admin
# Uniquement pour les commandes lancées depuis l'hôte avec compose.test.yaml.
DATABASE_URL=postgresql://storymaster_app:local-only-app-db@localhost:55432/storymaster
MIGRATION_DATABASE_URL=postgresql://storymaster_migrator:local-only-migration-db@localhost:55432/storymaster
TEST_DATABASE_URL=postgresql://storymaster_migrator:local-only-migration-db@localhost:55432/storymaster_test
TEST_APP_DATABASE_URL=postgresql://storymaster_app:local-only-app-db@localhost:55432/storymaster_test
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Invitation : 48 h par défaut ; bornes techniques 300..604800 secondes.
INVITATION_TTL_SECONDS=172800
